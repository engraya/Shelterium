# Bayut RapidAPI key — used ONLY by /api/sync to seed/refresh Neon
# Obtain from https://rapidapi.com/apidojo/api/bayut
RAPID_API_KEY=

# Neon serverless PostgreSQL connection string
# Create a free project at https://neon.tech, then copy the connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Random secret string to protect the /api/sync endpoint from public access
# Generate any random string, e.g.: openssl rand -hex 32
SYNC_SECRET=
